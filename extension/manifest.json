{
  "manifest_version": 3,
  "name": "MyJD Click'n'Load",
  "short_name": "MyJD CNL",
  "version": "1.0.1",
  "description": "Forwards Click'n'Load buttons and links to your JDownloader via MyJDownloader.",
  "homepage_url": "https://github.com/loopnlucid/myjd-clicknload",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "webRequest",
    "declarativeNetRequestWithHostAccess",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MyJD Click'n'Load",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cnl_rules",
        "enabled": false,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["cnl/jdcheck.js", "cnl/crossdomain.xml", "cnl/flash.txt"],
      "matches": ["<all_urls>"]
    }
  ]
}
